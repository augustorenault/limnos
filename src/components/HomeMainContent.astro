---
import {
  formatMetric,
  getLiveMetrics,
  getMetricsScrollerConfig,
  LIMNOS_METRICS_RATES_PER_SEC,
  LIMNOS_METRICS_START_MS,
  METRICS_SCROLL_TARGET_MS,
} from '../data/limnos-metrics';

const metrics = getLiveMetrics();
const scrollClientes = getMetricsScrollerConfig(metrics.clientes, METRICS_SCROLL_TARGET_MS.clientes);
const scrollAmostras = getMetricsScrollerConfig(metrics.amostras, METRICS_SCROLL_TARGET_MS.amostras);
const scrollAnalises = getMetricsScrollerConfig(metrics.analises, METRICS_SCROLL_TARGET_MS.analises);
---
<div class="content">
  <section>
    <!--STARTCOMPONENTS-->

    <!-- ===================== HERO ===================== -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__media" aria-hidden="true">
        <video
          class="banner__video"
          src="/video/banner-video.mp4"
          preload="metadata"
          muted
          loop
          autoplay
          playsinline
        ></video>
        <span class="hero__veil"></span>
      </div>
      <div class="container hero__inner">
        <div class="hero__content" data-reveal>
          <h1 id="hero-title" class="hero__title">LIMNOS</h1>
          <p class="eyebrow">Análises ambientais confiáveis</p>
          <h2 class="hero__lead">Há mais de 35 anos oferecemos soluções ambientais para empresas.</h2>
          <div class="hero__text">
            <p>Análises, Amostragem e Relatórios Ambientais.</p>
            <p>Resultados no tempo que você necessita e com padrão de qualidade certificado.</p>
            <p>Atendimento em todo o país através de laboratórios regionais com equipe técnica especializada e equipamentos de ponta.</p>
          </div>
          <div class="hero__actions">
            <a href="/contato" title="Entre em contato" class="btn btn--primary">
              Entre em contato
              <i class="fas fa-arrow-up-right-from-square ms-2" aria-hidden="true"></i>
            </a>
            <a href="/empresa" title="Conheça a Limnos" class="btn btn--outline">Conheça a Limnos</a>
          </div>
          <ul class="hero__meta list-unstyled">
            <li class="hero__meta-item"><i class="fas fa-flask-vial" aria-hidden="true"></i> Laboratórios regionais</li>
            <li class="hero__meta-item"><i class="fas fa-user-gear" aria-hidden="true"></i> Equipe técnica especializada</li>
            <li class="hero__meta-item"><i class="fas fa-certificate" aria-hidden="true"></i> Qualidade certificada</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===================== MÉTRICAS ===================== -->
    <section class="section stats">
      <div class="bg-counter-relative stats__wrap">
        <div class="bg-counter-relative--absolute stats__media" aria-hidden="true">
          <video src="/video/metricas.mp4" muted loop autoplay playsinline preload="metadata"></video>
          <span class="stats__veil"></span>
        </div>
        <div class="counter">
          <div class="container">
            <div
              class="stats__grid"
              data-reveal
              data-metrics-live
              data-metrics-start={LIMNOS_METRICS_START_MS}
              data-rate-clientes={LIMNOS_METRICS_RATES_PER_SEC.clientes}
              data-rate-amostras={LIMNOS_METRICS_RATES_PER_SEC.amostras}
              data-rate-analises={LIMNOS_METRICS_RATES_PER_SEC.analises}
            >
              <div class="stat">
                <h2
                  class="numscroller stat__num fw-light"
                  data-metric="clientes"
                  data-scroll-ms={METRICS_SCROLL_TARGET_MS.clientes}
                  data-min="1"
                  data-max={metrics.clientes}
                  data-delay={scrollClientes.delay}
                  data-increment={scrollClientes.increment}
                >{formatMetric(metrics.clientes)}</h2>
                <h3 class="stat__label">clientes atendidos</h3>
              </div>
              <div class="stat">
                <h2
                  class="numscroller stat__num fw-light"
                  data-metric="amostras"
                  data-scroll-ms={METRICS_SCROLL_TARGET_MS.amostras}
                  data-min="1"
                  data-max={metrics.amostras}
                  data-delay={scrollAmostras.delay}
                  data-increment={scrollAmostras.increment}
                >{formatMetric(metrics.amostras)}</h2>
                <h3 class="stat__label">amostras coletadas</h3>
              </div>
              <div class="stat">
                <h2
                  class="numscroller stat__num fw-light"
                  data-metric="analises"
                  data-scroll-ms={METRICS_SCROLL_TARGET_MS.analises}
                  data-min="1"
                  data-max={metrics.analises}
                  data-delay={scrollAnalises.delay}
                  data-increment={scrollAnalises.increment}
                >{formatMetric(metrics.analises)}</h2>
                <h3 class="stat__label">análises realizadas</h3>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== SERVIÇOS ===================== -->
    <section class="section serv-home">
      <div class="container-fluid">
        <div class="section__head text-center" data-reveal>
          <h2 class="title-subtitle fs-2"><span>Confira Também</span>Nossos Serviços</h2>
        </div>
        <div class="row justify-content-center">
          <div class="row g-0" data-reveal>
            <div class="col-lg-6">
              <div class="d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100">
                <h2 class="my-2 text-dark">Avaliação de Qualidade da Água e seus Organismos</h2>
                <p>A avaliação da qualidade da água é fundamental para garantir a preservação dos recursos hídricos, a conformidade ambiental de empreendimentos e a proteção da saúde humana e dos ecossistemas. A LIMNOS realiza serviços completos de coleta, monitoramento e análises ambientais...</p>
                <a href="/servicos/avaliacao-de-qualidade-da-agua-e-seus-organismos" class="btn btn-dark" title="Saiba mais sobre Avaliação de Qualidade da Água e seus Organismos">Saiba mais</a>
              </div>
            </div>
            <div class="col-lg-6">
              <img class="w-100 h-100 object-fit-cover" loading="lazy" src="/doutor/uploads/6/servicos/2025/04/cover-avaliacao-de-qualidade-da-agua-e-seus-organismos-fc65b43f29.webp" alt="Avaliação de Qualidade da Água e seus Organismos" title="Avaliação de Qualidade da Água e seus Organismos">
            </div>
          </div>

          <div class="row flex-row-reverse g-0" data-reveal>
            <div class="col-lg-6">
              <div class="d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100">
                <h2 class="text-dark my-2">Monitoramento de Emissões Atmosféricas</h2>
                <p>O monitoramento de emissões atmosféricas é uma etapa essencial para empresas que buscam atender à legislação ambiental, controlar seus processos produtivos e reduzir impactos ao meio ambiente. A LIMNOS realiza avaliações completas de poluentes atmosféricos...</p>
                <a href="/servicos/monitoramento-de-emissoes-atmosfericas" class="btn btn-dark" title="Saiba mais sobre Monitoramento de Emissões Atmosféricas">Saiba mais</a>
              </div>
            </div>
            <div class="col-lg-6">
              <img class="w-100 h-100 object-fit-cover" loading="lazy" src="/doutor/uploads/6/servicos/2025/04/cover-monitoramento-de-emissoes-atmosfericas-f17a1dcb8e.webp" alt="Monitoramento de Emissões Atmosféricas" title="Monitoramento de Emissões Atmosféricas">
            </div>
          </div>

          <div class="row g-0" data-reveal>
            <div class="col-lg-6">
              <div class="d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100">
                <h2 class="my-2 text-dark">Monitoramento de Qualidade do Ar</h2>
                <p>O monitoramento da qualidade do ar é uma ferramenta fundamental para avaliar os impactos das atividades industriais, minerárias, logísticas e urbanas sobre o meio ambiente e a saúde da população. A LIMNOS oferece soluções completas para monitoramento ambiental da atmosfera...</p>
                <a href="/servicos/monitoramento-de-qualidade-do-ar" class="btn btn-dark" title="Saiba mais sobre Monitoramento de Qualidade do Ar">Saiba mais</a>
              </div>
            </div>
            <div class="col-lg-6">
              <img class="w-100 h-100 object-fit-cover" loading="lazy" src="/doutor/uploads/6/servicos/2025/04/cover-monitoramento-de-qualidade-do-ar-14415ecda1.webp" alt="Monitoramento de Qualidade do Ar" title="Monitoramento de Qualidade do Ar">
            </div>
          </div>

          <div class="row flex-row-reverse g-0" data-reveal>
            <div class="col-lg-6">
              <div class="d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100">
                <h2 class="text-dark my-2">Monitoramento de Ruídos e Vibrações</h2>
                <p>O monitoramento de ruídos e vibrações é essencial para avaliar os impactos gerados por atividades industriais, minerárias, obras de infraestrutura, operações logísticas e empreendimentos urbanos sobre o meio ambiente e as comunidades do entorno. A LIMNOS realiza medições e análises especializadas...</p>
                <a href="/servicos/monitoramento-de-ruidos-e-vibracoes" class="btn btn-dark" title="Saiba mais sobre Monitoramento de Ruídos e Vibrações">Saiba mais</a>
              </div>
            </div>
            <div class="col-lg-6">
              <img class="w-100 h-100 object-fit-cover" loading="lazy" src="/doutor/uploads/6/servicos/2025/04/cover-monitoramento-de-ruidos-e-vibracoes-8cbbb129cf.webp" alt="Monitoramento de Ruídos e Vibrações" title="Monitoramento de Ruídos e Vibrações">
            </div>
          </div>

          <div class="row g-0" data-reveal>
            <div class="col-lg-6">
              <div class="d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100">
                <h2 class="my-2 text-dark">Avaliação de Materiais, Resíduos e Solos</h2>
                <p>A correta caracterização de materiais, resíduos e solos é fundamental para o gerenciamento ambiental, atendimento às exigências legais e tomada de decisões seguras em projetos industriais, minerários, de infraestrutura e saneamento. A LIMNOS oferece serviços especializados...</p>
                <a href="/servicos/avaliacao-de-residuos-e-solos" class="btn btn-dark" title="Saiba mais sobre Avaliação de Materiais, Resíduos e Solos">Saiba mais</a>
              </div>
            </div>
            <div class="col-lg-6">
              <img class="w-100 h-100 object-fit-cover" loading="lazy" src="/doutor/uploads/6/servicos/2025/04/cover-avaliacao-de-residuos-e-solos-cf21b43a04.webp" alt="Avaliação de Materiais, Resíduos e Solos" title="Avaliação de Materiais, Resíduos e Solos">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== DESTAQUES MPI ===================== -->
    <section class="section section--soft">
      <div class="container">
        <div class="destaques-mpi">
          <div class="section__head text-center" data-reveal>
            <h2 class="title-subtitle fs-2"><span>PÁGINAS EM </span>destaque</h2>
          </div>
          <div class="row row-cols-2 row-cols-md-2 row-cols-lg-4 g-3 g-lg-4 justify-content-center" data-reveal>
            <div>
              <div class="card card--mpi">
                <a class="card__link" rel="nofollow" href="/amostragem-baixa-vazao-low-flow" title="Amostragem de baixa vazão low flow">
                  <img class="card__image" loading="lazy" src="/imagens/informacoes/amostragem-baixa-vazao-low-flow-01.webp" alt="Imagem ilustrativa de Amostragem de baixa vazão low flow" title="Amostragem de baixa vazão low flow">
                  <h3 class="card__title">Amostragem de baixa vazão low flow</h3>
                </a>
              </div>
            </div>
            <div>
              <div class="card card--mpi">
                <a class="card__link" rel="nofollow" href="/analise-atmosferica" title="Análise atmosférica">
                  <img class="card__image" loading="lazy" src="/imagens/informacoes/analise-atmosferica-01.webp" alt="Imagem ilustrativa de Análise atmosférica" title="Análise atmosférica">
                  <h3 class="card__title">Análise atmosférica</h3>
                </a>
              </div>
            </div>
            <div>
              <div class="card card--mpi">
                <a class="card__link" rel="nofollow" href="/analise-bacteriologica-da-agua" title="Análise bacteriológica da água">
                  <img class="card__image" loading="lazy" src="/imagens/informacoes/analise-bacteriologica-da-agua-01.webp" alt="Imagem ilustrativa de Análise bacteriológica da água" title="Análise bacteriológica da água">
                  <h3 class="card__title">Análise bacteriológica da água</h3>
                </a>
              </div>
            </div>
            <div>
              <div class="card card--mpi">
                <a class="card__link" rel="nofollow" href="/analise-biologica-da-agua" title="Análise biológica da água">
                  <img class="card__image" loading="lazy" src="/imagens/informacoes/analise-biologica-da-agua-01.webp" alt="Imagem ilustrativa de Análise biológica da água" title="Análise biológica da água">
                  <h3 class="card__title">Análise biológica da água</h3>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!--ENDCOMPONENTS-->
  </section>
</div>
