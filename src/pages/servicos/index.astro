---
import Layout from '../../layouts/Layout.astro';

const title = "Serviços - LIMNOS";
const description = "Serviços - Análises e coletas em águas potáveis, residuais (efluentes), subterrâneas e superficiais em ambiente marinho e de água doce. Avaliaçã...Saiba...";
const keywords = "";
const content = "<div id=\"servicos\">\n    <section itemscope itemtype=\"https://schema.org/Services\">\n        <div class=\"bread bread--default\">\n    <div class=\"container\">\n        <div class=\"bread__row\">\n            <nav aria-label=\"breadcrumb\" >\n    <ol id=\"breadcrumb\" data-bread-sig>\n    <li class=\"bread__column\">\n    <a href=\"/\" title=\"Home\">Home</a>\n    </li>\n          <li class=\"bread__column\">Serviços</li></ol>\n  </nav>            <h1 class=\"bread__title\">Serviços</h1>\n        </div>\n    </div>\n</div>        <div>        <!-- SE ESTIVER SETADO PARA TRUE NA CLIENT.INC.PHP MOSTRA DESCRIÇÃO DA CATEGORIA  -->\n                    <div class=\"container\">\n                <div class=\"category-content\">\n                                    </div>\n            </div>\n<div class=\"container-fluid reset-aside-sig\">\n    <div class=\"d-flex flex-wrap justify-content-center flex-xl-row-reverse\">\n        <article class=\"col-12\">\n            <div class=\"row justify-content-center ps-0 ps-lg-0\">\n                                                                                    <div class=\"row g-0\">\n                                <div class=\"col-lg-6  bg-dark\">\n                                    <div class=\"d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100\">\n                                        <h2 class=\" light my-2\">Avaliação de Qualidade da Água e seus Organismos</h2>\n                                        <p class=\"content_serv light\">\n\nA avaliação da qualidade da água é fundamental para garantir a preservação dos recursos hídricos, a conformidade ambiental de empreendimentos e a proteção da saúde humana e dos ecossistemas. A LIMNOS realiza serviços completos de coleta, monitoramento e análises ambientais...</p>\n                                    <a href=\"/servicos/avaliacao-de-qualidade-da-agua-e-seus-organismos\" class=\"btn btn-light\" title=\"Saiba mais sobre Avaliação de Qualidade da Água e seus Organismos\">Saiba mais</a>\n                                    </div>\n                                </div>\n                                <div class=\"col-lg-6\">\n                                    <img class=\"w-100 h-100 object-fit-cover\" loading=\"lazy\" src=\"/doutor/uploads/6/servicos/2025/04/cover-avaliacao-de-qualidade-da-agua-e-seus-organismos-fc65b43f29.webp\" alt=\"Avaliação de Qualidade da Água e seus Organismos\" title=\"Avaliação de Qualidade da Água e seus Organismos\">\n                                </div>\n                            </div>\n                            \n                                                                        <div class=\"row flex-row-reverse g-0\">\n                                    <div class=\"col-lg-6\">\n                                        <div class=\"d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100\">\n                                            <h2 class=\"text-dark my-2\">Avaliação de Materiais, Resíduos e Solos</h2>\n                                            <p class=\"\">A correta caracterização de materiais, resíduos e solos é fundamental para o gerenciamento ambiental, atendimento às exigências legais e tomada de decisões seguras em projetos industriais, minerários, de infraestrutura e saneamento. A LIMNOS oferece serviços especializados...</p>\n                                            <a href=\"/servicos/avaliacao-de-residuos-e-solos\" class=\"btn btn-dark\" title=\"Saiba mais sobre Avaliação de Materiais, Resíduos e Solos\">Saiba mais</a>\n\n                                        </div>\n                                    </div>\n                                    <div class=\"col-lg-6\">\n                                        <img class=\"w-100 h-100 object-fit-cover\" loading=\"lazy\" src=\"/doutor/uploads/6/servicos/2025/04/cover-avaliacao-de-residuos-e-solos-cf21b43a04.webp\" alt=\"Avaliação de Materiais, Resíduos e Solos\" title=\"Avaliação de Materiais, Resíduos e Solos\">\n                                    </div>\n                                </div>\n\n                        \n                                                                    <div class=\"row g-0\">\n                                <div class=\"col-lg-6  bg-dark\">\n                                    <div class=\"d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100\">\n                                        <h2 class=\" light my-2\">Monitoramento de Emissões Atmosféricas</h2>\n                                        <p class=\"content_serv light\">O monitoramento de emissões atmosféricas é uma etapa essencial para empresas que buscam atender à legislação ambiental, controlar seus processos produtivos e reduzir impactos ao meio ambiente. A LIMNOS realiza avaliações completas de poluentes atmosféricos...</p>\n                                    <a href=\"/servicos/monitoramento-de-emissoes-atmosfericas\" class=\"btn btn-light\" title=\"Saiba mais sobre Monitoramento de Emissões Atmosféricas\">Saiba mais</a>\n                                    </div>\n                                </div>\n                                <div class=\"col-lg-6\">\n                                    <img class=\"w-100 h-100 object-fit-cover\" loading=\"lazy\" src=\"/doutor/uploads/6/servicos/2025/04/cover-monitoramento-de-emissoes-atmosfericas-f17a1dcb8e.webp\" alt=\"Monitoramento de Emissões Atmosféricas\" title=\"Monitoramento de Emissões Atmosféricas\">\n                                </div>\n                            </div>\n                            \n                                                                        <div class=\"row flex-row-reverse g-0\">\n                                    <div class=\"col-lg-6\">\n                                        <div class=\"d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100\">\n                                            <h2 class=\"text-dark my-2\">Monitoramento de Qualidade do Ar</h2>\n                                            <p class=\"\">O monitoramento da qualidade do ar é uma ferramenta fundamental para avaliar os impactos das atividades industriais, minerárias, logísticas e urbanas sobre o meio ambiente e a saúde da população. A LIMNOS oferece soluções completas para monitoramento ambiental da atmosfera...</p>\n                                            <a href=\"/servicos/monitoramento-de-qualidade-do-ar\" class=\"btn btn-dark\" title=\"Saiba mais sobre Monitoramento de Qualidade do Ar\">Saiba mais</a>\n\n                                        </div>\n                                    </div>\n                                    <div class=\"col-lg-6\">\n                                        <img class=\"w-100 h-100 object-fit-cover\" loading=\"lazy\" src=\"/doutor/uploads/6/servicos/2025/04/cover-monitoramento-de-qualidade-do-ar-14415ecda1.webp\" alt=\"Monitoramento de Qualidade do Ar\" title=\"Monitoramento de Qualidade do Ar\">\n                                    </div>\n                                </div>\n\n                        \n                                                                    <div class=\"row g-0\">\n                                <div class=\"col-lg-6  bg-dark\">\n                                    <div class=\"d-flex p-4 align-items-start justify-content-center flex-column h-100 w-100\">\n                                        <h2 class=\" light my-2\">Monitoramento de Ruídos e Vibrações</h2>\n                                        <p class=\"content_serv light\">O monitoramento de ruídos e vibrações é essencial para avaliar os impactos gerados por atividades industriais, minerárias, obras de infraestrutura, operações logísticas e empreendimentos urbanos sobre o meio ambiente e as comunidades do entorno. A LIMNOS realiza medições e análises especializadas...</p>\n                                    <a href=\"/servicos/monitoramento-de-ruidos-e-vibracoes\" class=\"btn btn-light\" title=\"Saiba mais sobre Monitoramento de Ruídos e Vibrações\">Saiba mais</a>\n                                    </div>\n                                </div>\n                                <div class=\"col-lg-6\">\n                                    <img class=\"w-100 h-100 object-fit-cover\" loading=\"lazy\" src=\"/doutor/uploads/6/servicos/2025/04/cover-monitoramento-de-ruidos-e-vibracoes-8cbbb129cf.webp\" alt=\"Monitoramento de Ruídos e Vibrações\" title=\"Monitoramento de Ruídos e Vibrações\">\n                                </div>\n                            </div>\n                            \n                            </div>\n        </article>\n            </div>\n    <div class=\"d-flex justify-content-end pt-3 pt-lg-0\">\n            </div>\n</div>        </div>\n    </section>\n</div>";
---

<Layout title={title} description={description} keywords={keywords}>
  <Fragment set:html={content} />
</Layout>
